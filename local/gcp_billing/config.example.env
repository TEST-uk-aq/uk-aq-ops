# Private local runtime file: copy to ~/.local/share/uk-aq-gcp-billing/TEST/.env
# or ~/.local/share/uk-aq-gcp-billing/LIVE/.env and chmod 600.
# Values are literal KEY=VALUE; no shell expansion and no passwords/API keys.
# Confirm actual earliest available usage_date before any backfill.
UK_AQ_BILLING_ENVIRONMENT=REPLACE_TEST_OR_LIVE
UK_AQ_BILLING_QUERY_PROJECT=REPLACE_GCP_PROJECT_ID
UK_AQ_BILLING_DATASET=REPLACE_GCP_PROJECT_ID.REPLACE_DATASET_ID
UK_AQ_BILLING_LOCATION=REPLACE_DATASET_LOCATION
UK_AQ_BILLING_BILLING_ACCOUNT_ID=REPLACE_BILLING_ACCOUNT
UK_AQ_BILLING_EARLIEST_USAGE_DATE=REPLACE_YYYY-MM-DD
UK_AQ_BILLING_ARCHIVE_ROOT="/REPLACE_DROPBOX_ROOT/Apps/github-uk-air-quality-networks/REPLACE_TEST_OR_LIVE/gcp_billing"
UK_AQ_BILLING_MYSQL_DATABASE=REPLACE_MYSQL_DATABASE
UK_AQ_BILLING_MYSQL_USER=REPLACE_MYSQL_WRITER
UK_AQ_BILLING_MYSQL_SOCKET=REPLACE_MYSQL_SOCKET_PATH
UK_AQ_BILLING_OVERLAP_SECONDS=7200
UK_AQ_BILLING_SETTLING_SECONDS=120
UK_AQ_BILLING_MAXIMUM_BYTES_BILLED=1073741824
UK_AQ_BILLING_MAXIMUM_RUN_BYTES=8589934592
UK_AQ_BILLING_MAXIMUM_DAYS_PER_BATCH=14
UK_AQ_BILLING_RUN_HISTORY_LIMIT=200
