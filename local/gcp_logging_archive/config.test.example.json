{
  "project_id": "REPLACE_WITH_TEST_GCP_PROJECT_ID",
  "log_filter": "resource.type=\"cloud_run_revision\" AND (resource.labels.service_name=\"uk-aq-latest-snapshot-builder\" OR resource.labels.service_name=\"REPLACE_WITH_TEST_INGEST_SERVICE_NAME\")",
  "archive_id": "test-gcp-logging-dropbox-v1",
  "archive_root": "~/Dropbox/REPLACE_WITH_ARCHIVE_FOLDER",
  "state_dir": "~/.local/state/uk-aq/gcp-logging-archive/test",
  "run_evidence_root": "~/Library/Logs/UK-AQ/gcp-logging-archive/test/runs",
  "page_size": 1000,
  "min_read_interval_seconds": 1.5,
  "quota_retry_initial_seconds": 5.0,
  "quota_retry_max_seconds": 60.0,
  "quota_retry_timeout_seconds": 600.0,
  "overlap_seconds": 7200,
  "settling_delay_seconds": 120,
  "initial_lookback_seconds": 86400,
  "backfill_window_hours": 6,
  "redact_paths": [
    "httpRequest.requestUrl",
    "jsonPayload.authorization",
    "jsonPayload.headers.authorization",
    "jsonPayload.token",
    "jsonPayload.password"
  ]
}
