{
  "environment": "REPLACE_WITH_TEST_OR_LIVE",
  "project_id": "REPLACE_WITH_ENVIRONMENT_GCP_PROJECT_ID",
  "log_filter": "resource.type=\"cloud_run_revision\" AND (resource.labels.service_name=\"uk-aq-latest-snapshot-builder\" OR resource.labels.service_name=\"REPLACE_WITH_ENVIRONMENT_INGEST_SERVICE_NAME\")",
  "archive_id": "REPLACE_WITH_STABLE_ENVIRONMENT_ARCHIVE_ID",
