<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>co.uk.chronicillnesschannel.aq.gcp-logging-archive.test</string>
  <key>ProgramArguments</key><array><string>__REPO_ROOT__/local/scripts/run_gcp_logging_archive_test.sh</string><string>incremental</string></array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__REPO_ROOT__/logs/gcp_logging_archive_test_launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO_ROOT__/logs/gcp_logging_archive_test_launchd.log</string>
</dict></plist>
