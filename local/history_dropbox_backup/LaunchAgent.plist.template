<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__SUPERVISOR__</string>
    <string>--environment</string><string>__ENVIRONMENT__</string>
    <string>--config</string><string>__CONFIG__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>NODE_EXTRA_CA_CERTS</key><string>__POSTGRESCA__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>Umask</key><integer>63</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>__OUTPUT__/stdout.log</string>
  <key>StandardErrorPath</key><string>__OUTPUT__/stderr.log</string>
</dict>
</plist>
