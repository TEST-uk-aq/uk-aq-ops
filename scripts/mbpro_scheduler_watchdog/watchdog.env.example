# Copy outside the repository, set values, then use install_launchagent.sh --config.
UKAQ_ENV_NAME=TEST

UK_AQ_SCHEDULER_TRIGGER_SECRET=REDACTED
UK_AQ_INGEST_SCHEDULER_URL=https://INGEST-SCHEDULER-WORKER.example
UK_AQ_OPS_SCHEDULER_URL=https://OPS-SCHEDULER-WORKER.example

DROPBOX_APP_KEY=REDACTED
DROPBOX_APP_SECRET=REDACTED
DROPBOX_REFRESH_TOKEN=REDACTED
UK_AQ_DROPBOX_ROOT=/TEST

UK_AQ_SCHEDULER_WATCHDOG_OFFSET_SECONDS=30
UK_AQ_SCHEDULER_WATCHDOG_REQUEST_TIMEOUT_SECONDS=900
UK_AQ_SCHEDULER_WATCHDOG_MAX_IN_FLIGHT_PER_WORKER=4
