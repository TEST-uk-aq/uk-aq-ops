# Add these non-secret settings to the selected TEST repository root .env.
# The Google identity running Integrity also needs roles/run.invoker on the
# Latest Snapshot Cloud Run service.
# Local operator invocation may select the base account and impersonated caller
# explicitly with these standard gcloud environment variables:
# CLOUDSDK_CORE_ACCOUNT="BASE-GCLOUD-ACCOUNT"
# CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT="INTEGRITY-CALLER-SERVICE-ACCOUNT"

UK_AQ_INTEGRITY_CURRENT_STATE_RECONCILIATION_ENABLED="false"
UK_AQ_INTEGRITY_TIMESERIES_RECONCILIATION_RPC="uk_aq_rpc_timeseries_current_state_reconcile"
UK_AQ_INTEGRITY_LATEST_SNAPSHOT_RECONCILE_URL="https://TEST-SERVICE-URL/internal/integrity-reconcile"
UK_AQ_INTEGRITY_LATEST_SNAPSHOT_RECONCILE_AUDIENCE="https://TEST-SERVICE-URL"
UK_AQ_INTEGRITY_LATEST_SNAPSHOT_RECONCILE_TIMEOUT_SECONDS="300"
